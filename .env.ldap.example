# LDAP-Konfiguration für Match-Werkstatt

# LDAP-Server Einstellungen
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your-ldap-password

# LDAP-Integration aktivieren (true/false)
LDAP_ENABLED=true

# LDAP-Benutzer-Attribute
LDAP_USER_FILTER=(uid=%username%)
LDAP_USERNAME_ATTRIBUTE=uid
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_DISPLAY_NAME_ATTRIBUTE=displayName

# Fallback auf lokale Authentifizierung (true/false)
LDAP_ALLOW_LOCAL_FALLBACK=true

# LDAP-TLS/SSL Einstellungen
LDAP_USE_TLS=false
LDAP_REJECT_UNAUTHORIZED=false
