# LDAP-Konfiguration für Match-Werkstatt

# MongoDB Einstellungen
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your-secure-root-password
MONGO_DB_NAME=matchdb
DB_NAME=db-name
MONGO_APP_USER=matchuser
MONGO_APP_PASSWORD=your-secure-app-password

MONGODB_URL="mongodb://user:Password@IP:Port/db-name?authSource=db-name"

# Backup Einstellungen
BACKUP_TIME=03:00
BACKUP_RETAIN_COUNT=7
TZ=Europe/Berlin
BACKUP_DIR=/var/backups/match/werkstatt

# LDAP-Server Einstellungen
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_SEARCH_BASE=ou=someone,dc=somedomain,dc=something,dc=com
LDAP_DOMAIN=domain
LDAP_USER_DN_TEMPLATES=CN={{username}},ou=someone,dc=somedomain,dc=something,dc=com
LDAP_BIND_DN=bind_dn
LDAP_BIND_PASSWORD=your-ldap-password

# Netzwerkordner (SMB/CIFS) Einstellungen
SMB_SHARE_PATH=\\IP\path
NETWORK_CLIPBOARD_PATH=\\Domain\path
SMB_USERNAME=dein_nutzer
SMB_PASSWORD=dein_passwort
SMB_DOMAIN=deine_domain # (Optional)

# SMTP-E-Mail Einstellungen
SMTP_HOST=email.de
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=your_smtp_sender_email

# App URL für E-Mails
APP_URL=http://XXX.XXX.XXX.XXX:XXXXX
